{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Security headers (same as Railpack's default staticfile Caddyfile,
	# with blob: added — this page self-bootstraps script/img/font resources
	# via blob: URLs, which the default CSP blocks)
	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' blob: https: *; font-src 'self' data: blob: https: *; connect-src 'self' blob: https: *; media-src 'self' blob: https: *; object-src 'none'; frame-src 'self' https: *; worker-src 'self' blob:;"
		-Server
	}

	root * .

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html /index.html

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
